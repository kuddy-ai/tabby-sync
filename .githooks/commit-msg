#!/usr/bin/env bash
set -euo pipefail

msg_file="$1"
msg="$(cat "$msg_file")"
first_line="$(head -n1 "$msg_file")"

commit_regex='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|security)(\([a-z0-9._-]+\))?(!)?: .+'
issue_regex='(Refs|Closes|Fixes):? #[0-9]+'

if ! echo "$first_line" | grep -Eq "$commit_regex"; then
  echo "ERROR: Commit message must follow Conventional Commits."
  echo "Example: feat(auth): add login flow"
  exit 1
fi

if ! echo "$msg" | grep -Eq "$issue_regex"; then
  echo "ERROR: Commit message must reference an Issue."
  echo "Add one of: Refs: #123 / Closes: #123 / Fixes: #123"
  exit 1
fi
