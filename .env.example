# Application environment
APP_ENV=development
APP_LOG_LEVEL=info

# Never put real secrets in this file.
# Copy this file to .env locally and fill values outside Git.

# Example placeholders only:
# DATABASE_URL=
# API_BASE_URL=
# API_TOKEN=

# tabby-sync runtime
# TABBY_SYNC_ADDR=:8080
# TABBY_SYNC_DATA_DIR=./var/tabby-sync
# TABBY_SYNC_USERS_FILE=./var/tabby-sync/users.json
# TABBY_SYNC_MASTER_KEY_PROVIDER=env  # allowed: env|file
