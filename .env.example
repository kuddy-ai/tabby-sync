# Runtime log level: error, warn, info, or debug.
APP_LOG_LEVEL=info

# Docker first-boot display name. It is used only when users.yml does not
# already exist in the persistent data volume.
TABBY_SYNC_USER_NAME=default

# The Docker image already supplies the three path/provider values below.
# Export them when running the binary directly from source.
# TABBY_SYNC_ADDR=:8080
# TABBY_SYNC_DATA_DIR=./var/tabby-sync
# TABBY_SYNC_USERS_FILE=./var/tabby-sync/users.yml
# TABBY_SYNC_MASTER_KEY_PROVIDER=file

# For the env master-key provider only. Never commit a real value.
# TABBY_SYNC_MASTER_KEY=<64 hexadecimal characters>
